# Stage 12 — server-side environment for the YAK nutrition service.
# Copy this file to .env (untracked) when running the server yourself.
# Never commit a real key, and never move this key into the Expo app.

# Free key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# Port the service listens on. Defaults to 8787 if unset.
PORT=8787
